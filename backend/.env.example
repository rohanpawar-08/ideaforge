# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# Environment Modes:
# - Local / Development:
#     APP_ENV=development
#     DATABASE_URL= (leave empty to fallback to local SQLite: sqlite:///./ideaforge.db, or provide local postgres URL)
# - Render / Production:
#     APP_ENV=production
#     DATABASE_URL=<Neon PostgreSQL URL, e.g. postgresql://user:pass@ep-xyz.neon.tech/ideaforge?sslmode=require>

APP_ENV=development
DATABASE_URL=
SECRET_KEY=
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=https://ideaforge-steel-alpha.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Email Service (Phase 4 Account Lifecycle):
# Supported providers: resend, postmark, sendgrid (development mode logs safely to console)
EMAIL_PROVIDER=resend
EMAIL_FROM=IdeaForge <noreply@ideaforge.dev>
EMAIL_API_KEY=
FRONTEND_URL=https://ideaforge-steel-alpha.vercel.app

# AI Reliability, Timeouts, Retries & Usage Limits (Phase 6):
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
AI_DAILY_PLAN_LIMIT=10
AI_DAILY_COMPARE_LIMIT=20
AI_DAILY_REGENERATE_LIMIT=30
AI_DAILY_CHAT_LIMIT=50
AI_DAILY_VIVA_LIMIT=20
