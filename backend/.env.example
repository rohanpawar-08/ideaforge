# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# Environment Modes:
# - Local / Development:
#     APP_ENV=development
#     DATABASE_URL= (leave empty to fallback to local SQLite: sqlite:///./ideaforge.db, or provide local postgres URL)
# - Render / Production:
#     APP_ENV=production
#     DATABASE_URL=<Neon PostgreSQL URL, e.g. postgresql://user:pass@ep-xyz.neon.tech/ideaforge?sslmode=require>

APP_ENV=development
DATABASE_URL=
SECRET_KEY=
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=https://ideaforge-steel-alpha.vercel.app,http://localhost:5173,http://127.0.0.1:5173
