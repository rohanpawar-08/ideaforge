# Copy this file to .env and fill in real values. Never commit the real .env file.

# LLM API configuration (Get a free key from https://console.groq.com or https://aistudio.google.com)
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# PostgreSQL database (Get free Postgres from https://neon.tech or https://supabase.com)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/ideaforge

# JWT Authentication Secret Key (generate a secure random string for production)
SECRET_KEY=your_jwt_secret_key_change_in_production
