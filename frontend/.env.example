# IdeaForge Frontend Environment Variables
# Copy to .env for local overrides if needed.
# Do NOT place backend secrets, database credentials, or private API keys here.

# Target IdeaForge backend API URL
# Development default: http://localhost:8000
# Production default: https://ideaforge-senx.onrender.com
VITE_API_URL=https://ideaforge-senx.onrender.com
